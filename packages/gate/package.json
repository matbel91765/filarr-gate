{
  "name": "@filarr/gate",
  "version": "0.1.0",
  "description": "Read and write the rows of a Filarr database opened to an API, from your own Node, Deno, Bun or Cloudflare Worker code, without Filarr ever seeing your data.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/types/gate/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/gate/src/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "fflate": "^0.8.3"
  }
}
